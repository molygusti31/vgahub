{
  "name": "weighing-scale-dashboard",
  "version": "1.0.0",
  "description": "Dashboard untuk logging dan monitoring timbangan",
  "main": "server_marugo.js",
  "bin": "server_marugo.js",
  "scripts": {
    "start": "node server_marugo.js",
    "simulate": "node simulator.js",
    "import:materials": "node import-materials.js",
    "dev": "npm start",
    "build:exe": "pkg dashboard-launcher.js --targets node24.18.1-win-x64 --output build/Manager.exe && electron-builder --win portable --x64",
    "build:linux": "bash build-linux.sh"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "weighing",
    "scale",
    "dashboard"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "better-sqlite3": "^12.11.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.4",
    "npm": "^12.2.1",
    "sqlite3": "^5.1.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.5.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "pkg": {
    "scripts": [
      "dashboard-launcher.js",
      "manager.js",
      "server_marugo.js",
      "database_marugo.js",
      "license.js",
      "node_modules/sqlite3/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "control-center/**/*",
      "db_marugo.db",
      "node_modules/better-sqlite3/build/Release/*.node"
    ],
    "outputPath": "build"
  },
  "build": {
    "appId": "com.vgahub.dashboard",
    "productName": "VGAHub Dashboard",
    "asar": true,
    "directories": {
      "output": "build/electron-dist"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "package.json",
      "control-center/vgahub.ico",
      "!node_modules/**"
    ],
    "extraMetadata": {
      "main": "electron-main.js",
      "dependencies": {}
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/Manager.exe",
        "to": "Manager.exe"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/vgahub.ico"
    },
    "portable": {
      "artifactName": "Dashboard-Windows.exe"
    }
  }
}
